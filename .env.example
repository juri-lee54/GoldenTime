# =================================================================
# Golden Time 환경 설정 템플릿 (.env.example)
# 실제 구동 시 이 파일을 복사하여 '.env' 파일을 생성하고 키를 입력하세요.
# =================================================================

# -----------------------------------------------------------------
# 1. 외부 API 인증키 (External API Credentials)
# -----------------------------------------------------------------
# 공공데이터포털 국립중앙의료원 전국 응급의료기관 정보 조회 서비스 ServiceKey
# 발급: https://www.data.go.kr/data/15000563/openapi.do
PUBLIC_DATA_KEY=your_public_data_api_key_here

# Kakao Developers REST API 키 (로컬 검색 및 모빌리티 길찾기)
# 발급: https://developers.kakao.com/
KAKAO_API_KEY=your_kakao_rest_api_key_here

# -----------------------------------------------------------------
# 2. 배정 알고리즘 하이퍼파라미터 (선택 사항 - 기본값 내장)
# -----------------------------------------------------------------
# 도심지 응급차량 평균 주행 속도 (km/h)
VEHICLE_AVG_SPEED_KMH=40.0

# 가용 병상 역수 페널티 가중치 계수 (alpha / beds)
BED_PENALTY_ALPHA=5.0

# 병상 고갈 시 부과되는 페널티 상수
BED_EXHAUSTED_PENALTY=99999.0

# -----------------------------------------------------------------
# 3. 네트워크 및 로깅 설정
# -----------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
